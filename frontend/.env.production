# Production Environment Variables
# 주의: Vite 가 실제로 읽는 파일은 점(.)으로 시작하는 이 파일이다.
#      점 없는 env.production 은 문서용 사본이라 빌드에 반영되지 않는다.
# 예전에 이 값이 프론트 자신의 주소(vercel.app)로 잘못 들어가 있었다.
# vercel.json 이 모든 경로를 index.html 로 돌려보내므로, 그 상태로 빌드되면
# 모든 API 호출이 HTML 을 받아 오게 된다 (실측: 405, JSON 아님).
VITE_API_BASE_URL=https://refrigeratorcode-production.up.railway.app
VITE_ENV=production
VITE_DEBUG=false

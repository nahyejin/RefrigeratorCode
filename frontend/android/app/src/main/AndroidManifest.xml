<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 소셜 로그인 복귀: 시스템 브라우저에서 로그인이 끝나면 서버가
                 com.cookmatch.app://auth?code=... 로 보낸다(backend NATIVE_APP_SCHEME,
                 프론트 utils/nativeAuth.ts). 받은 주소는 Capacitor 가 appUrlOpen 으로 넘긴다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cookmatch.app" android:host="auth" />
            </intent-filter>

            <!-- 홈 화면 "재료 찍기" 위젯(CameraWidgetProvider)이 여는 주소.
                 로그인 복귀와 같은 스킴이고 host 만 camera 다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cookmatch.app" android:host="camera" />
            </intent-filter>

            <!-- 위젯의 「물어보기」 버튼 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cookmatch.app" android:host="chat" />
            </intent-filter>

            <!-- 위젯의 「AI 식단」 버튼 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cookmatch.app" android:host="plan" />
            </intent-filter>

            <!-- 정사각형 위젯의 「내 냉장고」 버튼 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.cookmatch.app" android:host="fridge" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯 3×1 — 재료 찍기 / 물어보기 / AI 식단 -->
        <receiver
            android:name=".QuickWidgetProvider"
            android:label="@string/widget_quick_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>

        <!-- 홈 화면 위젯 2×2(정사각형) — 위 셋 + 내 냉장고 -->
        <receiver
            android:name=".QuickWidgetSquareProvider"
            android:label="@string/widget_quick_square_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_square_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 푸시 알림(FCM) 기본값 — 앱이 꺼져 있을 때 OS가 직접 그리는 알림에 쓰인다.
             상태바 아이콘은 흰색 단색이어야 해서(컬러 앱 아이콘을 쓰면 흰 네모로 뭉개짐)
             로고 글리프만 뽑은 ic_stat_cookmatch 를 쓴다. 채널 id 는 프론트
             `EXPIRY_CHANNEL_ID`·발송 배치 `FCM_CHANNEL_ID` 와 같은 값. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_cookmatch" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="expiry" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 안드로이드 13+ 는 알림 권한을 선언하고 런타임에 물어봐야 알림이 뜬다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>

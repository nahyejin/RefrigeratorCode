<?xml version="1.0" encoding="utf-8"?>
<!-- 쿡매치 버튼 위젯의 버튼 바탕 — 옅은 회색 둥근 네모 타일.
     동그라미 아이콘 + 아래 글자는 버튼 영역이 어디까지인지 모호하고 칸 맞추기가 어려워서(2026-09-23 사용자 지적)
     버튼 하나 = 타일 하나로 바꿨다. 색은 values/values-night 의 widget_circle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_circle" />
    <corners android:radius="14dp" />
</shape>

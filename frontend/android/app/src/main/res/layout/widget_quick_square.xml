<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 2×2(정사각형).
     윗줄은 「요리 AI」를 가로로 긴 알약 버튼으로 둔다(클로드 위젯처럼). 알약 높이는 아래 동그라미와 같은 40dp —
     weight 로 늘리면 세로로 부풀어 혼자 커 보였다(2026-09-23 지적) — 정사각형은 자리가 남아서
     동그라미 세 개를 억지로 배치하면 허전하다. 아랫줄에 재료 찍기·AI 식단 두 개(2026-09-23 요청).
     좌우 여백: 알약은 카드 안쪽 padding(14dp)에 맞춰 꽉 차고, 아래 두 버튼은 **바깥 모서리를 알약과 같은 선**에
     맞춘다(왼쪽 버튼은 왼쪽 정렬, 오른쪽 버튼은 오른쪽 정렬). 가운데 정렬로 두면 아래 줄만 안쪽으로 들어가
     그리드가 어긋나 보인다(2026-09-23 지적).
     색·모양 리소스는 가로형(widget_quick.xml)과 같은 것을 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center">

    <!-- 윗줄: 가로로 긴 「요리 AI」 -->
    <LinearLayout
        android:id="@+id/widget_chat_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_pill_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:contentDescription="@string/widget_chat_label">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_chat"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_chat_label"
            android:textSize="13sp"
            android:textColor="@color/widget_label"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 아랫줄: 재료 찍기 · AI 식단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/widget_camera_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="left|center_vertical"
            android:contentDescription="@string/widget_camera_label">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_camera"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_camera_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_plan_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="right|center_vertical"
            android:contentDescription="@string/widget_plan_label">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_plan"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_plan_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

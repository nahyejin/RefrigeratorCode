<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 2×2(정사각형) — 흰 카드 안에 **둥근 네모 타일** 세 개.
     윗줄: 넓은 「요리 AI」 타일(아이콘 옆 글자) / 아랫줄: 「재료 찍기」·「AI 식단」 타일 둘.
     바깥 투명 FrameLayout(square_root)에 Provider 가 여백을 줘 흰 카드를 정사각형으로 맞춘다(런처 칸 비율과 무관).
     위아래 줄 높이와 타일 사이 간격(8dp)이 같아 세 타일이 한 그리드에 선다 — 동그라미 아이콘으로 두면 버튼 영역이
     모호하고 가운데로 몰려 보였다(2026-09-23 사용자 지적). 색·모양은 가로형(widget_quick.xml)과 같은 타일. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/square_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="10dp">

        <!-- 윗줄: 「요리 AI」 -->
        <LinearLayout
            android:id="@+id/widget_chat_button"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/widget_tile_bg"
            android:contentDescription="@string/widget_chat_label">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_chat"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_chat_label"
                android:textSize="14sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 아랫줄: 재료 찍기 · AI 식단 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_camera_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/widget_tile_bg"
                android:contentDescription="@string/widget_camera_label">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_camera"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/widget_camera_label"
                    android:textSize="12sp"
                    android:textColor="@color/widget_label"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_plan_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/widget_tile_bg"
                android:contentDescription="@string/widget_plan_label">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_plan"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/widget_plan_label"
                    android:textSize="12sp"
                    android:textColor="@color/widget_label"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

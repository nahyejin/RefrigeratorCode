<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 2×2(정사각형) — 가로 3×1 과 같은 디자인, 버튼만 넷(재료 찍기·물어보기·AI 식단·내 냉장고).
     가로가 안 맞는 홈 화면 배치를 위해 정사각형도 고를 수 있게 둔다(2026-09-23 요청).
     색·모양은 3×1 과 같은 리소스를 쓴다 — 한쪽만 바뀌는 일이 없게. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/widget_camera_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_camera_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_camera"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_camera_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_chat_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_chat_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_chat"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_chat_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/widget_plan_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_plan_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_plan"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_plan_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_fridge_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_fridge_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_widget_fridge"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_fridge_label"
                android:textSize="11sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

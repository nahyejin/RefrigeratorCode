<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 2×2(정사각형).
     윗줄은 「요리 AI」를 가로로 긴 알약 버튼으로 둔다(클로드 위젯처럼). 알약 높이는 아래 동그라미와 같은 40dp —
     weight 로 늘리면 세로로 부풀어 혼자 커 보였다(2026-09-23 지적) — 정사각형은 자리가 남아서
     동그라미 세 개를 억지로 배치하면 허전하다. 아랫줄에 재료 찍기·AI 식단 두 개(2026-09-23 요청).
     좌우 여백: 알약과 아이콘 줄이 **같은 폭**을 쓰고, 아래 두 버튼은 **알약의 양 끝선에 맞춘다**(왼쪽 버튼은 왼쪽 끝,
     오른쪽 버튼은 오른쪽 끝) — 세 요소가 같은 그리드에 선다. 예전엔 두 버튼을 반쪽 칸의 가운데에 둬서, 폭이 좁은
     실제 폰에서는 카메라·식단 동그라미가 가운데로 몰려 붙어 보였다(2026-09-23 지적 — 다음 버전). 바깥 여백도 줄였다.
     색·모양 리소스는 가로형(widget_quick.xml)과 같은 것을 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center">

    <!-- 윗줄: 가로로 긴 「요리 AI」 -->
    <LinearLayout
        android:id="@+id/widget_chat_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_pill_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:contentDescription="@string/widget_chat_label">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_chat"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_chat_label"
            android:textSize="14sp"
            android:textColor="@color/widget_label"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 아랫줄: 재료 찍기 · AI 식단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_camera_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_camera_label">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="12dp"
                android:src="@drawable/ic_widget_camera"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_camera_label"
                android:textSize="12sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 두 버튼 사이 빈 칸 — 버튼을 양 끝선으로 민다(RemoteViews 는 일반 View 를 못 써서 FrameLayout) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_plan_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_plan_label">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="12dp"
                android:src="@drawable/ic_widget_plan"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_plan_label"
                android:textSize="12sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

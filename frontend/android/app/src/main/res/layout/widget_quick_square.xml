<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 2×2(정사각형).
     윗줄은 「요리 AI」를 가로로 긴 알약 버튼으로 둔다(클로드 위젯처럼). 알약 높이는 아래 동그라미와 같은 40dp —
     weight 로 늘리면 세로로 부풀어 혼자 커 보였다(2026-09-23 지적) — 정사각형은 자리가 남아서
     동그라미 세 개를 억지로 배치하면 허전하다. 아랫줄에 재료 찍기·AI 식단 두 개(2026-09-23 요청).
     좌우 여백: 알약과 아이콘 줄에 **같은 안쪽 여백(4dp)** 을 줘서 세 요소가 같은 그리드에 놓이게 한다.
     알약을 카드 끝까지 늘리면 아래 두 버튼만 안쪽에 있는 것처럼 보이고, 버튼을 양 끝에 붙이면 둘이
     너무 멀어진다 — 둘 다 같은 폭 안에 둔다. 여백은 최소로 하고 대신 알약·동그라미를 키워 카드를 꽉 채운다(2026-09-23 지적 세 번 반영).
     색·모양 리소스는 가로형(widget_quick.xml)과 같은 것을 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center">

    <!-- 윗줄: 가로로 긴 「요리 AI」 -->
    <LinearLayout
        android:id="@+id/widget_chat_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_pill_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:contentDescription="@string/widget_chat_label">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_chat"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_chat_label"
            android:textSize="14sp"
            android:textColor="@color/widget_label"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 아랫줄: 재료 찍기 · AI 식단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/widget_camera_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_camera_label">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="12dp"
                android:src="@drawable/ic_widget_camera"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_camera_label"
                android:textSize="12sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_plan_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_plan_label">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_bg"
                android:padding="12dp"
                android:src="@drawable/ic_widget_plan"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/widget_plan_label"
                android:textSize="12sp"
                android:textColor="@color/widget_label"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

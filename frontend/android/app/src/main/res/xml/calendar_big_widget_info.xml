<?xml version="1.0" encoding="utf-8"?>
<!-- 요리 캘린더 위젯 4×3(늘리면 4×4) — 목표 게이지 + 달력 + 범례. 보기 전용.
     4×4 로 두면 아이콘이 있는 보통 홈 화면에는 자리가 안 나 아예 놓이지 않았다(2026-09-23) → 기본 4×3. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_calendar_big"
    android:description="@string/widget_calendar_big_description"
    android:initialLayout="@layout/widget_calendar_big"
    android:updatePeriodMillis="1800000" />
